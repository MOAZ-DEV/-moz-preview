{
  "name": "@moz/preview",
  "version": "0.1.0",
  "description": "Responsive preview library",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/index.css": "./dist/index.css",
    "./styles.css": "./dist/index.css"
  },
  "style": "dist/index.css",
  "files": [
    "dist"
  ],
  "scripts": {
    "gen:css": "bun scripts/gen-styles.ts",
    "build": "npm run gen:css && tsup && postcss src/components/style.css -o dist/index.css && tsc -p tsconfig.types.json",
    "build:css": "postcss src/components/style.css -o dist/index.css",
    "dev": "npm run gen:css && concurrently \"tsup --watch\" \"bun scripts/gen-styles.ts --watch\" \"postcss src/components/style.css -o dist/index.css --watch --verbose\"",
    "dev:css": "postcss src/components/style.css -o dist/index.css --watch",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "sideEffects": ["*.css"],
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.28",
    "postcss-cli": "^12.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  }
}
